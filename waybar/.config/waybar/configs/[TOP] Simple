	"idle_inhibitor#s",
	"group/stats",
	"hyprland/workspaces#rw",
	"custom/playerctl",
	],

"modules-center": [
	"clock#5",
	"group/notify",
	],

"modules-right": [
	"group/apps",
	"group/info",
	"custom/nightlight#s",
	"custom/power#s",
	],
}

