/* hx :: rofi — configuración base (fósforo verde) */

configuration {
    modi:                 "drun,run,window";
    /* iconos de app (Papirus no instalado: Yaru verde del sistema) */
    show-icons:           true;
    icon-theme:           "Yaru-prussiangreen-dark";
    terminal:             "kitty";
    font:                 "JetBrainsMono Nerd Font 11";

    /* formato tipo terminal */
    drun-display-format:  "{name}";
    window-format:        "{w} :: {c} :: {t}";
    display-drun:         "hx@run:~$";
    display-run:          "hx@exec:~$";
    display-window:       "hx@win:~$";

    /* comportamiento */
    matching:             "fuzzy";
    sort:                 true;
    sorting-method:       "fzf";
    case-sensitive:       false;
    cycle:                true;
    disable-history:      false;
    hover-select:         true;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
    kb-cancel:            "Escape,Control+g,Control+bracketleft";
}

/* tema: se resuelve relativo a este archivo (~/.config/rofi/hx.rasi) */
@import "hx.rasi"
